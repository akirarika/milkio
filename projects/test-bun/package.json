{
  "name": "test-bun",
  "description": "Milkio Bun-runtime compatibility demo. This project intentionally uses the Bun runtime (cookbook.toml runtime = \"bun\") and the scripts below intentionally invoke the `bun` binary; it is NOT part of the pnpm/Node tooling and needs Bun installed only when this demo is started.",
  "type": "module",
  "private": true,
  "module": "index.ts",
  "scripts": {
    "dev": "bun run --bun --smol --no-install ./.milkio/run.ts",
    "build": "bun build --entrypoints ./.milkio/run.ts --outdir=./dist --target=bun --format=esm --sourcemap=linked --splitting --minify",
    "drizzle": "drizzle-kit"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.6.0",
    "@milkio/astra": "workspace:*",
    "@milkio/stargate": "workspace:*",
    "@milkio/vite-plugin-milkio": "workspace:*",
    "@mjackson/node-fetch-server": "^0.6.1",
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "elysia": "^1.4.28",
    "koa": "^3.2.1",
    "milkid": "^3.0.0",
    "milkio": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rolldown": "^1.0.0-beta.1",
    "rxjs": "^7.8.2",
    "tsx": "^4.19.3",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typia": "14.0.0",
    "vite": "^8.1.0",
    "vite-plugin-node": "^8.0.0"
  }
}
